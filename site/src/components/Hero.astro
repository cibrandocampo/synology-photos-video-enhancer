---
---
<section id="hero" class="relative overflow-hidden">
  <div class="mx-auto max-w-6xl px-6 py-20 sm:py-28 lg:py-32 text-center">
    <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-2xl bg-enhancer-900/60 shadow-xl shadow-enhancer-900/50 border border-enhancer-700/40">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="40"
        height="40"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="text-enhancer-300"
        aria-hidden="true"
      >
        <rect width="18" height="14" x="3" y="5" rx="2"/>
        <path d="m16 10-4-2-4 2v4l4 2 4-2z"/>
      </svg>
    </div>
    <h1 class="mt-8 text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-tight">
      Fix the videos Synology Photos <span class="text-brand">ruins.</span>
    </h1>
    <p class="mt-6 mx-auto max-w-2xl text-lg sm:text-xl text-slate-300 leading-relaxed">
      Synology Photos re-encodes every video to 15 fps H.264 Baseline — files that stutter on Chromecast and look noticeably worse than the originals.
      <span class="block mt-2 text-slate-400 text-base">This container fixes them automatically: H.264 High Profile or H.265/HEVC, hardware-accelerated, running quietly on your NAS.</span>
    </p>
    <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center items-center">
      <a
        href="#self-host"
        class="inline-flex items-center justify-center rounded-lg bg-enhancer-500 px-6 py-3 text-base font-semibold text-white shadow-lg shadow-enhancer-900/40 hover:bg-enhancer-600 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-enhancer-300 focus-visible:ring-offset-2 focus-visible:ring-offset-enhancer-950"
      >
        Self-host in 5 minutes
      </a>
      <a
        href="https://github.com/cibrandocampo/synology-photos-video-enhancer"
        class="inline-flex items-center justify-center rounded-lg border border-slate-700 bg-slate-900/60 px-6 py-3 text-base font-medium text-slate-200 hover:bg-slate-800/60 hover:border-slate-600 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-slate-400 focus-visible:ring-offset-2 focus-visible:ring-offset-enhancer-950"
      >
        <svg viewBox="0 0 16 16" class="h-5 w-5 mr-2" fill="currentColor" aria-hidden="true"><path d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.37-.93-.9-1.18-.9-1.18-.73-.5.06-.49.06-.49.8.06 1.22.83 1.22.83.72 1.22 1.88.87 2.34.66.07-.52.28-.87.5-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.13 0 0 .67-.22 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.11.16 1.93.08 2.13.51.56.82 1.28.82 2.15 0 3.07-1.86 3.75-3.65 3.95.29.25.54.74.54 1.5v2.22c0 .21.15.46.55.38A8 8 0 0 0 8 0Z"/></svg>
        Star on GitHub
      </a>
    </div>
    <p class="mt-6 text-sm text-slate-500">MIT-licensed · Docker images for amd64 + arm64 · Synology-friendly</p>
  </div>
</section>
