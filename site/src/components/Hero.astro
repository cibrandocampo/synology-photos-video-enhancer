---
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const logoSrc = `${base}/logo.svg`
const gifSrc  = `${base}/demo-15fps.gif`

const hwPills = ['QSV · Intel iGPU', 'VAAPI · AMD/Intel GPU', 'V4L2M2M · ARM', 'amd64 + arm64']
---
<section id="hero" class="relative overflow-hidden">
  <div class="mx-auto max-w-6xl px-6 py-20 sm:py-28 lg:py-32">
    <div class="flex flex-col items-center gap-16 lg:flex-row lg:items-center lg:gap-12">

      <!-- Left column: brand + copy + CTAs -->
      <div class="flex-1 text-center lg:text-left">

        <div class="flex items-center gap-4 justify-center lg:justify-start">
          <img
            src={logoSrc}
            alt="Synology Photos Video Enhancer"
            width="64"
            height="64"
            class="rounded-xl shadow-xl shadow-enhancer-900/60 shrink-0"
          />
          <p class="text-xs font-mono tracking-widest text-enhancer-400 uppercase select-all leading-tight">
            synology-photos-<br/>video-enhancer
          </p>
        </div>

        <h1 class="mt-6 text-4xl sm:text-5xl lg:text-5xl font-semibold tracking-tight">
          Fix the videos<br/>Synology Photos <span class="text-brand">ruins.</span>
        </h1>

        <p class="mt-5 text-lg text-slate-300 leading-relaxed max-w-xl mx-auto lg:mx-0">
          Every upload is silently re-encoded to <strong class="text-slate-100">15&nbsp;fps H.264&nbsp;Baseline</strong> —
          files that stutter on Chromecast and look degraded on any screen.
          This container re-transcodes them automatically: H.264&nbsp;High Profile or H.265/HEVC,
          hardware-accelerated, running on a schedule.
        </p>

        <div class="mt-5 flex flex-wrap justify-center lg:justify-start gap-2">
          {hwPills.map((pill) => (
            <span class="rounded-full border border-slate-700 bg-slate-900/60 px-3 py-1 text-xs font-mono text-slate-400">
              {pill}
            </span>
          ))}
        </div>

        <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center lg:justify-start items-center">
          <a
            href="#self-host"
            class="inline-flex items-center justify-center rounded-lg bg-enhancer-500 px-6 py-3 text-base font-semibold text-white shadow-lg shadow-enhancer-900/40 hover:bg-enhancer-600 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-enhancer-300 focus-visible:ring-offset-2 focus-visible:ring-offset-enhancer-950"
          >
            Deploy in 5 minutes
          </a>
          <a
            href="https://github.com/cibrandocampo/synology-photos-video-enhancer"
            class="inline-flex items-center justify-center rounded-lg border border-slate-700 bg-slate-900/60 px-6 py-3 text-base font-medium text-slate-200 hover:bg-slate-800/60 hover:border-slate-600 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-slate-400 focus-visible:ring-offset-2 focus-visible:ring-offset-enhancer-950"
          >
            <svg viewBox="0 0 16 16" class="h-5 w-5 mr-2" fill="currentColor" aria-hidden="true">
              <path d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.37-.93-.9-1.18-.9-1.18-.73-.5.06-.49.06-.49.8.06 1.22.83 1.22.83.72 1.22 1.88.87 2.34.66.07-.52.28-.87.5-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.13 0 0 .67-.22 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.11.16 1.93.08 2.13.51.56.82 1.28.82 2.15 0 3.07-1.86 3.75-3.65 3.95.29.25.54.74.54 1.5v2.22c0 .21.15.46.55.38A8 8 0 0 0 8 0Z"/>
            </svg>
            Star on GitHub
          </a>
        </div>

        <p class="mt-5 text-sm text-slate-500 text-center lg:text-left">
          MIT-licensed · No SaaS · No telemetry · Your videos stay on your NAS
        </p>

      </div>

      <!-- Right column: GIF demo -->
      <div class="flex-1 flex flex-col items-center lg:items-end w-full max-w-md lg:max-w-none mx-auto">
        <figure class="w-full">
          <div class="rounded-2xl border border-slate-700 bg-slate-900/60 p-3 shadow-2xl shadow-enhancer-900/40">
            <img
              src={gifSrc}
              alt="Comparison of 60 fps, 30 fps and 15 fps video playback — 15 fps is what Synology Photos generates"
              class="rounded-xl w-full h-auto"
              loading="eager"
              decoding="async"
            />
          </div>
          <figcaption class="mt-3 text-center text-sm text-slate-400 leading-snug px-2">
            Synology Photos generates <span class="text-slate-200 font-medium">15&nbsp;fps H.264&nbsp;Baseline</span>
            for every upload — the intermediate file your devices actually stream.
          </figcaption>
        </figure>
      </div>

    </div>
  </div>
</section>
